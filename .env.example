# ===== Origem - variáveis de ambiente =====
# Espelho de variáveis. Cada workspace tem seu próprio .env:
#   - apps/api/.env  → DATABASE_URL, JWT_SECRET, PORT (ver apps/api/.env.example)
#   - apps/web/.env  → API_INTERNAL_URL=http://localhost:3001

# apps/api
DATABASE_URL=postgresql://origem:origem@localhost:5432/origem?schema=public
JWT_SECRET=substitua-por-um-segredo-longuito-com-pelo-menos-32-caracteres
PORT=3001
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# apps/web
API_INTERNAL_URL=http://localhost:3001

# Pagamento SIMULADO (sem gateways reais)
PAYMENT_MODE=simulated
SIMULATOR_SUCCESS_RATE=1.0
SIMULATOR_DELAY_MS=0